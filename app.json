{
  "expo": {
    "name": "HERIXA",
    "slug": "herixa",
    "scheme": "herixa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use your camera",
        "NSMicrophoneUsageDescription": "Allow HERIXA to use the microphone for voice questions.",
        "NSSpeechRecognitionUsageDescription": "Allow HERIXA to recognize your speech for voice questions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.herixa.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HERIXA to access your camera to scan monuments and view 3D AR overlays."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow HERIXA to use the microphone for voice questions.",
          "speechRecognitionPermission": "Allow HERIXA to recognize your speech for voice questions."
        }
      ],
      "@reactvision/react-viro",
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9c54530a-db87-4166-8540-8b2dc2957802"
      }
    }
  }
}
