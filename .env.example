# Centralized API Base URL for HeritageAR
# Default value for local browser or simulator development:
EXPO_PUBLIC_API_URL=http://localhost:5000

# Android development mode:
# - 'auto' (default): dynamically detects if running on an emulator vs. physical device
# - 'emulator': forces http://10.0.2.2:5000
# - 'physical': forces the physical device resolution path (using PC LAN IP)
EXPO_PUBLIC_ANDROID_DEV_MODE=auto

# Hardcoded local LAN IP (e.g., 192.168.1.10) to use for physical devices if automatic Metro host IP detection is unavailable
# EXPO_PUBLIC_LAN_IP=

# Generated Guest User ID printed by the seed script (npm run seed)
EXPO_PUBLIC_GUEST_USER_ID=

# Gemini API Configuration (if called directly or using client placeholder overrides)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

