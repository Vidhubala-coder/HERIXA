{
  "name": "herixa-backend",
  "version": "1.0.0",
  "description": "Backend API for HERIXA application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/utils/seed.ts",
    "typecheck": "tsc --noEmit",
    "start-ai": "cd ../ai && .\\.venv\\Scripts\\python -m uvicorn src.service:app --host 127.0.0.1 --port 8001"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jimp": "^0.16.13",
    "mongoose": "^8.5.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "rimraf": "^5.0.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "private": true
}
