PORT=5000
MONGODB_URI=mongodb://localhost:27017/heritage_ar
CLIENT_URL=https://herixa-backend.onrender.com
ALLOWED_ORIGINS=https://herixa-backend.onrender.com
NODE_ENV=production
GEMINI_API_KEY=

# Cloudinary Persistent Video Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional single URL format: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Centralized Timeout Configurations
GEMINI_CONTENT_TIMEOUT_MS=180000
GEMINI_IMAGE_DISCOVERY_TIMEOUT_MS=180000
GEMINI_SINGLE_RECOGNITION_TIMEOUT_MS=90000
GEMINI_MULTI_RECOGNITION_TIMEOUT_MS=120000
GEMINI_ASSISTANT_TIMEOUT_MS=60000

# 3D Model Generation Configuration
TRIPOD_API_KEY=
THREED_PROVIDER=tripo

# Email & JWT Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
PASSWORD_RESET_BASE_URL=http://localhost:5000

# AI Service Configuration
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=6000

# Cloud AI Assistant configuration (Groq)
AI_ASSISTANT_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000
GROQ_MODEL_CACHE_TTL_MS=600000

